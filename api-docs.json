          type: string
          description: 누적 거래량
          example: '12.3456789'
        candleDateTimeKst:
          type: string
          description: 캔들 시작 일시 (KST, yyyy-MM-dd HH:mm:ss)
          example: '2026-10-14 14:30:00'
        timestamp:
          type: string
          description: 캔들 생성 시각 (Unix epoch milliseconds)
          example: '1791955800000'
        updateTs:
          type: string
          nullable: true
          description: 캔들 최종 변경 시각 (Unix epoch milliseconds). 생성 시각과 같으면 생략됩니다.
          example: '1791955812345'
