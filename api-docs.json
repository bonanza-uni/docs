    ReqOhlcvData:
      type: object
      description: 거래소별 OHLCV 조회 요청
      required:
        - tranDtime
        - tranNo
        - marketCodes
        - exchangeNm
      properties:
        tranDtime:
          type: string
          description: 요청 거래일시 (yyyyMMddHHmmss)
          example: '20261014143000'
        tranNo:
          type: string
          description: 요청별 고유 거래번호
          example: '202610141430000001'
        marketCodes:
          type: array
          description: 조회할 마켓 코드 목록 (1~5개)
          minItems: 1
          maxItems: 5
          example:
            - KRW-BTC
          items:
            type: string
        exchangeNm:
          type: string
          description: 거래소명
          example: upbit
          enum:
            - upbit
            - bithumb
            - coinone
            - digitalx
            - gopax
        lastCandleDtm:
          type: string
          description: 조회 기준 마지막 캔들 일시 (yyyyMMddHHmm). 생략하면 최신 확정 캔들을 기준으로 조회합니다.
          example: '202610141430'
        limit:
          type: string
          description: 마켓별 요청 캔들 수 (0~100, 기본값 1)
          default: '1'
          example: '100'
        candleUnit:
          type: string
          description: '캔들 주기 (I: 1분, H: 1시간, D: 1일, W: 1주, M: 1개월)'
          default: I
          example: I
          enum:
            - I
            - H
            - D
            - W
            - M
